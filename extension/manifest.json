{
  "manifest_version": 3,
  "name": "Alt-IA · Janela do agente",
  "version": "1.0.0",
  "description": "Mostra o agente Alt-IA em uma mini janela ao trocar de aba.",
  "permissions": ["windows", "storage"],
  "host_permissions": ["https://ai.bigbanana.io/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://ai.bigbanana.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
